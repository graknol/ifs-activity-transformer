# ============================================================================
# IFS Activity Transformer Configuration
# ============================================================================

# ----------------------------------------------------------------------------
# Oracle Database Configuration (Optional - only if using database connection)
# ----------------------------------------------------------------------------
ORACLE_USER=your_username
ORACLE_PASSWORD=your_password
ORACLE_HOST=your_host
ORACLE_PORT=1521
ORACLE_SERVICE=your_service_name

# ----------------------------------------------------------------------------
# Flask Web Application Configuration
# ----------------------------------------------------------------------------
FLASK_SECRET_KEY=your_secret_key_here
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ----------------------------------------------------------------------------
# Machine Learning Model Configuration
# ----------------------------------------------------------------------------
# Model name from HuggingFace Hub (downloads automatically on first run)
MODEL_NAME=google/bigbird-roberta-base

# Training parameters
MAX_LENGTH=512
BATCH_SIZE=8
LEARNING_RATE=2e-5
NUM_EPOCHS=3

# Model save directory (local storage)
SAVE_DIR=./models/saved

# ----------------------------------------------------------------------------
# Azure Blob Storage Configuration (Optional - for annotation backups)
# ----------------------------------------------------------------------------
# Get connection string from Azure Portal > Storage Account > Access Keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_CONTAINER_NAME=ifs-annotations
AUTO_BACKUP_THRESHOLD=10

# ----------------------------------------------------------------------------
# GPU/Performance Configuration (Auto-detected, these are optional overrides)
# ----------------------------------------------------------------------------
# The application automatically detects GPU and optimizes settings
# Uncomment to override automatic detection:
# FORCE_CPU=false
# CUDA_VISIBLE_DEVICES=0

